{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://showmewhy.dev/schema/verification-surface-v2.json",
  "title": "ShowMeWhy Verification Surface V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "claims"],
  "properties": {
    "result": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "obligation", "risk", "required_witnesses", "witnesses", "next_action"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "obligation": {"type": "string", "minLength": 1},
          "material": {"type": "boolean", "default": true},
          "blocking": {"type": "boolean", "default": false},
          "risk": {"enum": ["low", "medium", "high"]},
          "priority": {"type": "integer", "minimum": 1, "maximum": 5, "default": 3},
          "requires_human_judgement": {"type": "boolean", "default": false},
          "required_witnesses": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["execution", "source", "measurement", "invariant", "counterexample", "boundary", "regression", "comparison"]}
          },
          "witnesses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "source", "outcome"],
              "properties": {
                "kind": {"enum": ["execution", "source", "measurement", "invariant", "counterexample", "boundary", "regression", "comparison"]},
                "source": {"type": "string", "minLength": 1},
                "outcome": {"enum": ["supports", "refutes", "inconclusive"]}
              }
            }
          },
          "unresolved_reason": {"type": "string"},
          "next_action": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
