{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://showmewhy.dev/schema/context-delta-v1.json",
  "title": "ShowMeWhy Context Delta V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["previous", "current"],
  "properties": {
    "previous": {"$ref": "verification-surface.schema.json"},
    "current": {"$ref": "verification-surface.schema.json"},
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "claim_ids", "witnesses"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "witnesses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "outcome"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "outcome": {"enum": ["supports", "refutes", "inconclusive"]},
                "finding": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "current": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "missing_that_mattered": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "impact": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "blocker": {"type": "string", "minLength": 1}
  }
}
