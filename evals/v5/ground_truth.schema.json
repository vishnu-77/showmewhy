{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://showmewhy.dev/schemas/v5-ground-truth.json",
  "title": "ShowMeWhy V5 blinded ground truth",
  "type": "object",
  "required": [
    "version",
    "task_id",
    "domain",
    "pairing",
    "task_prompt",
    "oracle_refs",
    "labeler_count",
    "adjudicated",
    "blinded_to_showmewhy",
    "claims"
  ],
  "properties": {
    "version": {
      "const": "v5-ground-truth-1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "pairing": {
      "type": "object"
    },
    "task_prompt": {
      "type": "string",
      "minLength": 1
    },
    "oracle_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "boundary_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "labeler_count": {
      "type": "integer",
      "minimum": 1
    },
    "adjudicated": {
      "type": "boolean"
    },
    "blinded_to_showmewhy": {
      "const": true
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "material",
          "failing",
          "human_review",
          "counterexample"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "boolean"
          },
          "failing": {
            "type": "boolean"
          },
          "human_review": {
            "type": "boolean"
          },
          "counterexample": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
