{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://showmewhy.dev/schemas/v5-pair-run.json",
  "title": "ShowMeWhy V5 raw paired execution bundle",
  "type": "object",
  "required": [
    "version",
    "design",
    "pair_status",
    "task_id",
    "domain",
    "pairing",
    "task_prompt",
    "execution_order",
    "task_execution_count",
    "command",
    "conditions",
    "workspace_equivalence",
    "ground_truth_present"
  ],
  "properties": {
    "version": {
      "const": "v5-pair-run-2"
    },
    "pair_status": {
      "enum": [
        "running",
        "valid",
        "invalid"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "pairing": {
      "type": "object",
      "required": [
        "pair_id",
        "repository",
        "revision",
        "task_prompt_sha256",
        "model",
        "agent_runtime",
        "tool_profile",
        "repeat_index"
      ]
    },
    "task_prompt": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ]
    },
    "execution_order": {
      "const": [
        "baseline",
        "showmewhy"
      ]
    },
    "command": {
      "type": "object"
    },
    "conditions": {
      "type": "object",
      "properties": {
        "baseline": {
          "$ref": "#/$defs/condition"
        },
        "showmewhy": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": false
    },
    "ground_truth_present": {
      "const": false
    },
    "worktree_root": {
      "type": "string"
    },
    "design": {
      "const": "single-task-posthoc-verification"
    },
    "task_execution_count": {
      "const": 1
    },
    "workspace_equivalence": {
      "type": "object",
      "required": [
        "pre_verification",
        "post_verification"
      ],
      "additionalProperties": false,
      "properties": {
        "pre_verification": {
          "enum": [
            "not_checked",
            "identical",
            "mismatch"
          ]
        },
        "post_verification": {
          "enum": [
            "not_checked",
            "identical",
            "modified"
          ]
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes",
        "lines"
      ]
    },
    "condition": {
      "type": "object",
      "required": [
        "role",
        "condition",
        "status",
        "seconds",
        "return_code",
        "timed_out",
        "stdout",
        "stderr",
        "git",
        "adapter_artifacts",
        "environment"
      ],
      "properties": {
        "role": {
          "enum": [
            "task-agent-result",
            "posthoc-verification"
          ]
        }
      }
    }
  }
}
